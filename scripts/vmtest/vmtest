#!/bin/bash
# Thin per-project shim — the vmtest engine is shared and lives in
# ~/Code/Claude Code Meta /vmtest/ (same pattern as superdev). Everything
# project-specific stays in this directory: config.sh, known-flaky.txt,
# guest-prep.sh (in-guest build steps), provision-warm.sh (image cache warm).
#
# Keep this path stable: permission allow rules, the uitest-ready-gate hook,
# and the e2e-verify skill all reference scripts/vmtest/vmtest.

set -uo pipefail

VMTEST_PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export VMTEST_PROJECT_DIR

VMTEST_ENGINE="/Users/niyaro/Code/Claude Code Meta /vmtest/vmtest"
[ -x "$VMTEST_ENGINE" ] || {
  echo "vmtest: shared engine not found at $VMTEST_ENGINE" >&2
  exit 1
}
exec "$VMTEST_ENGINE" "$@"
