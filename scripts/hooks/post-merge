#!/bin/bash
#
# post-merge — Rebuild web editor bundles after git merge/pull.
#
# Tracked source of truth. Installed into the shared hooks dir as a thin
# wrapper by scripts/install-hooks.sh; run `bash scripts/install-hooks.sh`
# once after a fresh clone to wire it up.
#
# Why: web bundles (milkdown.js, codemirror.js) are build artifacts not
# tracked in git. A merge can change web/ sources AND web/pnpm-lock.yaml or a
# package.json, so we reconcile node_modules with `pnpm install` before
# building, then gate the success message on `pnpm build`'s real exit code.

set -uo pipefail

echo "Post-merge: Rebuilding web editors..."

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$REPO_ROOT/web" || exit 0

if ! command -v pnpm >/dev/null 2>&1; then
    echo "Post-merge: WARNING - pnpm not found, skipping web build"
    echo "Recover with: cd web && pnpm install && pnpm build"
    exit 0
fi

# Reconcile node_modules with dependency changes the merge may have brought in
# (new deps in web/*/package.json, updated web/pnpm-lock.yaml). Plain
# `pnpm install` (NOT --frozen-lockfile): frozen fails whenever the lockfile
# isn't in perfect sync with the workspace manifests — exactly the state a
# merge can produce — which would trip the failure path below with no
# auto-recovery. Plain install reconciles and proceeds instead.
if ! pnpm install; then
    echo "Post-merge: ERROR - 'pnpm install' failed; web editors NOT rebuilt."
    echo "Recover with: cd web && pnpm install && pnpm build"
    exit 0
fi

if pnpm build; then
    echo "Post-merge: Web editors rebuilt successfully"
else
    echo "Post-merge: ERROR - 'pnpm build' failed; web editors are STALE."
    echo "Recover with: cd web && pnpm install && pnpm build"
    exit 0
fi
