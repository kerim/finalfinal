# Xcode
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node
node_modules/
web/node_modules/
web/milkdown/node_modules/
web/codemirror/node_modules/
web/milkdown/dist/
web/codemirror/dist/

# SQLite WAL/SHM files (transient, not part of package)
*.sqlite-shm
*.sqlite-wal

# Build outputs
final\ final/Resources/editor/
build/
releases/
temp/
*.tmp

# Claude Code runtime (not project config)
# .mcp.json must stay untracked: the sandbox hard-blocks writing that filename,
# so a tracked copy breaks worktree creation (see wiki: Per-Project MCP Configuration)
.mcp.json
.claude/worktrees/
.claude/settings.local.json
.claude/settings.json.bak.*
.claude/debug/
docs/plans/
docs/course/

# IDE
.idea/
.vscode/
*.swp
*.swo


# Git worktrees
.worktrees/

# Pre-commit test sentinel (mirrors annals)
.last-test-pass

# Diagnostic capture artifacts (Claude debugging sessions)
.diagnostic-*

# Misplaced sibling worktree (belongs at /Users/niyaro/Code/ff-dev)
ff-dev/
